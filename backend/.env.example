# ── Database ──
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/expense-splitter

# ── Auth ──
JWT_SECRET=replace-with-a-long-random-string

# Where the frontend lives. Verification and reset links are built from this,
# and it is added to the CORS allow-list.
APP_URL=http://localhost:5173

# ── Email (SMTP) ──
# Leave blank in development and links are printed to the server console
# instead of being emailed.
#
# Gmail: turn on 2FA, then create an App Password (not your normal password).
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
# Brevo: smtp-relay.brevo.com : 587
# Mailtrap (safe inbox for testing): sandbox.smtp.mailtrap.io : 2525
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Expense Splitter <no-reply@example.com>"

# ── Payments (Razorpay) ──
# Test keys from dashboard.razorpay.com -> Settings -> API Keys.
# Leave blank and the app falls back to UPI details + Mark as Paid.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional but recommended: set a webhook on payment.captured / payment.failed
# pointing at POST /api/payments/webhook, and paste its secret here.
RAZORPAY_WEBHOOK_SECRET=

# ── Server ──
PORT=5000
